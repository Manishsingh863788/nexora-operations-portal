# ==========================================
# NEXORA ERP - Environment Variables Example
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=nexora_erp_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=1d

# PostgreSQL Database URL
# Local Docker setup:
DATABASE_URL=postgresql://nexora_user:nexora_password@localhost:5432/nexora_db?schema=public

# Cloud PostgreSQL (Neon / Supabase example):
# DATABASE_URL=postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/nexora_db?sslmode=require

# Frontend URL (CORS allowed origin)
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
